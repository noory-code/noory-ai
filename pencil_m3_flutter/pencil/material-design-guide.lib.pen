              "fontFamily": "Inter",
              "fontSize": 20,
              "fontWeight": "600"
            },
            {
              "type": "frame",
              "id": "vUEUy",
              "name": "codeBox",
              "width": "fill_container",
              "fill": "$surfaceContainerHighest",
              "cornerRadius": 8,
              "layout": "vertical",
              "padding": 16,
              "children": [
                {
                  "type": "text",
                  "id": "AGe5f",
                  "name": "codeTxt",
                  "fill": "$onSurface",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "// 1. 기본 Switch\nbool _value = false;\nSwitch(\n  value: _value,\n  onChanged: (v) => setState(() => _value = v),\n);\n\n// 2. 아이콘 포함\nSwitch(\n  value: _value,\n  onChanged: (v) => setState(() => _value = v),\n  thumbIcon: WidgetStateProperty.resolveWith((states) {\n    if (states.contains(WidgetState.selected))\n      return const Icon(Icons.check, size: 16);\n    return const Icon(Icons.close, size: 16);\n  }),\n);\n\n// 3. SwitchListTile (레이블 포함)\nSwitchListTile(\n  title: const Text('Wi-Fi'),\n  subtitle: const Text('연결됨'),\n  value: _value,\n  onChanged: (v) => setState(() => _value = v),\n);\n\n// 4. Adaptive (플랫폼별 스타일)\nSwitch.adaptive(\n  value: _value,\n  onChanged: (v) => setState(() => _value = v),\n);",
                  "fontFamily": "Roboto Mono",
                  "fontSize": 12,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        }
      ]
    },
