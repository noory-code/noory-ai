                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "ListTile(\n  leading: Icon(Icons.inbox),\n  title: Text('Item title'),\n  subtitle: Text('Supporting text'),\n  trailing: Icon(Icons.chevron_right),\n  onTap: () {},\n)",
                  "fontFamily": "Roboto Mono",
                  "fontSize": 13,
                  "fontWeight": "normal"
                },
                {
                  "type": "rectangle",
                  "id": "4Q7Nj",
                  "name": "codeDivider",
                  "fill": "$outlineVariant",
                  "width": "fill_container",
                  "height": 1
                },
                {
                  "type": "text",
                  "id": "mGSd1",
                  "name": "code2",
                  "fill": "$onSurface",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "// Scrollable list\nListView.builder(\n  itemCount: items.length,\n  itemBuilder: (context, index) =>\n    ListTile(title: Text(items[index])),\n)",
                  "fontFamily": "Roboto Mono",
                  "fontSize": 13,
                  "fontWeight": "normal"
                },
                {
                  "type": "rectangle",
                  "id": "uQcOE",
                  "name": "codeDivider2",
                  "fill": "$outlineVariant",
                  "width": "fill_container",
                  "height": 1
                },
                {
                  "type": "text",
                  "id": "GQCi1",
                  "name": "code3",
                  "fill": "$onSurface",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "// With checkbox\nCheckboxListTile(\n  value: isChecked,\n  onChanged: (v) => setState(() => isChecked = v!),\n  title: Text('Item title'),\n)\n\n// With switch\nSwitchListTile(\n  value: isEnabled,\n  onChanged: (v) => setState(() => isEnabled = v),\n  title: Text('Item title'),\n  subtitle: Text('Supporting text'),\n)",
                  "fontFamily": "Roboto Mono",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        }
      ]
