                  "type": "text",
                  "id": "caKMe",
                  "name": "codeText",
                  "fill": "$onSurface",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "// Modal Bottom Sheet\nshowModalBottomSheet(\n  context: context,\n  builder: (context) => const SizedBox(\n    height: 300,\n    child: Center(child: Text('Content')),\n  ),\n);\n\n// Persistent Bottom Sheet\nScaffold.of(context).showBottomSheet(\n  (context) => const SizedBox(height: 200),\n);",
                  "lineHeight": 1.6,
                  "fontFamily": "Roboto Mono",
                  "fontSize": 12,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "text",
              "id": "Ml1NQ",
              "name": "usageTitle",
              "fill": "$onSurface",
              "content": "Flutter Usage",
              "fontFamily": "Inter",
              "fontSize": 16,
              "fontWeight": "600"
            },
            {
              "type": "frame",
              "id": "CIWTj",
              "name": "usageBox",
              "width": "fill_container",
              "fill": "$surfaceContainerHighest",
              "cornerRadius": 8,
              "layout": "vertical",
              "padding": 16,
              "children": [
                {
                  "type": "text",
                  "id": "sLcBe",
                  "name": "usageText",
                  "fill": "$onSurface",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "showModalBottomSheet(\n  context: context,\n  backgroundColor: cs.surfaceContainerLow,\n  shape: const RoundedRectangleBorder(\n    borderRadius: BorderRadius.vertical(\n      top: Radius.circular(AppRadius.xl), // 28dp\n    ),\n  ),\n  builder: (context) => Padding(\n    padding: EdgeInsets.fromLTRB(\n      AppSpacing.lg, AppSpacing.md,\n      AppSpacing.lg, AppSpacing.x2l,\n    ),\n    child: Column(\n      mainAxisSize: MainAxisSize.min,\n      children: [\n        Container(\n          width: 32, height: 4,\n          decoration: BoxDecoration(\n            color: cs.onSurfaceVariant\n              .withValues(alpha: AppOpacity.pressed),\n            borderRadius: BorderRadius.circular(AppRadius.xs),\n          ),\n        ),\n        SizedBox(height: AppSpacing.lg),\n        Text('옵션 선택', style: tt.titleMedium),\n      ],\n    ),\n  ),\n);",
                  "lineHeight": 1.6,
                  "fontFamily": "Roboto Mono",
                  "fontSize": 12,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        }
      ]
    },
