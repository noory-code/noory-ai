                  "type": "text",
                  "id": "t7Y83",
                  "name": "codeLine4",
                  "fill": "$onSurface",
                  "content": "    setState(() => _selectedIndex = index);",
                  "fontFamily": "Roboto Mono",
                  "fontSize": 12,
                  "fontWeight": "normal"
                },
