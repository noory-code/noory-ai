              "type": "frame",
              "id": "Q59wD",
              "name": "code-box",
              "width": "fill_container",
              "fill": "$surfaceContainerHighest",
              "cornerRadius": 8,
              "layout": "vertical",
              "padding": 20,
              "children": [
                {
                  "type": "text",
                  "id": "BxiZw",
                  "name": "code",
                  "fill": "$onSurface",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "// MaterialApp 세팅\nMaterialApp(\n  theme: AppTheme.light,\n  darkTheme: AppTheme.dark,\n  themeMode: ThemeMode.system,\n)\n\n// 위젯에서 색상 접근\nfinal cs = Theme.of(context).colorScheme;\n\n// Primary\ncs.primary              // $primary\ncs.onPrimary            // $onPrimary\ncs.primaryContainer     // $primaryContainer\n\n// Surface\ncs.surface              // $surface (기본)\ncs.surfaceDim           // $surfaceDim (어두운 surface)\ncs.surfaceBright        // $surfaceBright (밝은 surface)\ncs.surfaceContainer     // $surfaceContainer\n\n// Usage Examples\nContainer(color: cs.primary)\nText(&apos;Hello&apos;, style: TextStyle(color: cs.onSurface))\nCard(color: cs.surfaceContainerHighest)\nDivider(color: cs.outlineVariant)",
                  "fontFamily": "Roboto Mono",
                  "fontSize": 12,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        }
      ]
    },
