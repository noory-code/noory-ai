                  "type": "text",
                  "id": "25HxV",
                  "name": "codeLine7",
                  "fill": "$onSurface",
                  "content": "  destinations: const [",
                  "fontFamily": "Roboto Mono",
                  "fontSize": 12,
                  "fontWeight": "normal"
                },
