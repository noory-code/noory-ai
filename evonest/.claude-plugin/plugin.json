{
  "name": "evonest",
  "version": "1.2.0",
  "description": "AI-assisted code evolution plugin for Claude Code and Codex. 20 specialist personas analyze your codebase and propose improvements. All proposals are reviewed before execution, with auto-revert on test failure.",
  "homepage": "https://github.com/noory-code/noory-ai/tree/main/evonest",
  "repository": "https://github.com/noory-code/noory-ai",
  "license": "MIT",
  "keywords": [
    "mcp",
    "code-evolution",
    "autonomous",
    "refactoring",
    "ai-agent"
  ],
  "author": {
    "name": "noory-code",
    "url": "https://github.com/noory-code"
  },
  "commands": "./commands/",
  "skills": "./skills/",
  "hooks": "./hooks/hooks.json",
  "mcpServers": {
    "evonest": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
            "${CLAUDE_PLUGIN_ROOT}",
            "evonest"
        ],
        "env": {
          "EVONEST_AGENT_BACKEND": "claude"
        }
      }
  }
}
