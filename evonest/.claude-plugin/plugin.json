{
  "name": "evonest",
  "version": "1.1.1",
  "description": "AI-assisted code evolution plugin for Claude Code. 20 specialist personas analyze your codebase and propose improvements. All proposals reviewed before execution. Auto-revert on test failure. Proven: 164 proposals executed, zero regressions.",
  "homepage": "https://github.com/noory-code/noory-ai/tree/main/evonest",
  "repository": "https://github.com/noory-code/noory-ai",
  "license": "MIT",
  "keywords": [
    "mcp",
    "code-evolution",
    "autonomous",
    "refactoring",
    "ai-agent"
  ],
  "author": {
    "name": "noory-code",
    "url": "https://github.com/noory-code"
  },
  "commands": "./commands/",
  "skills": "./skills/",
  "hooks": "./hooks/hooks.json",
  "mcpServers": {
    "evonest": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${CLAUDE_PLUGIN_ROOT}",
        "evonest"
      ]
    }
  }
}
