{
  "description": "Notify user of remaining proposals after evonest_improve completes",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "evonest_improve",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/post-improve.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
