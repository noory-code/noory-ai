{
  // Selects the Stage responsibility topology and migration contract.
  "schema_version": 5,
  // Selects the language for human-readable project Stage documents.
  "language": "en",
  // Lists template-backed guidance files intentionally owned by this project.
  "guidance_overrides": [],
  // Lists project-owned operation documents that replace plugin defaults.
  "operations_overrides": [],
  // Maps each work kind to its required execution venue.
  "venue_routing": {},
  // Excludes project paths or extensions from Stage write governance.
  "governance": {
    "exclude_paths": [],
    "exclude_extensions": []
  },
  // Registers additional host tool names that can write files.
  "extra_write_tools": [],
  // Executor commands are project-specific. Give both venue prompts these instructions:
  // Read the selected card at $STAGE_WORK_ITEM_PATH and every ancestor card listed in $STAGE_WORK_ITEM_ANCESTOR_PATHS before acting; together they are the whole instruction.
  // Read failed criteria from the JSON object at $STAGE_REVIEW_VERDICT_FILE and use
  // each exact criterion string in Review dispositions (JSON).
  // Changed paths (JSON) must contain every repository-relative path changed for this card across all attempts.
  // Optional venue checks run before an executor attempt. A missing venue warns; null explicitly
  // declares that the venue needs no check. Replace null with a non-empty command to enable one.
  "preflights": {
    "claude": null,
    "codex": null
  },
  // These are per-action baselines. The driver keeps attempts fixed per action and
  // scales command timeout, iteration, and wall-clock ceilings to the target subtree's leaf count.
  "limits": {
    "max_attempts_per_item": 3,
    "max_iterations": 12,
    "max_wall_clock_seconds": 5400
  },
  // Review commands receive $STAGE_REVIEW_MODE (`full` or `narrow`),
  // $STAGE_REVIEW_VERDICT_FILE, and $STAGE_CHANGED_PATHS_FILE.
  // When $STAGE_PREVIOUS_REVIEW_VERDICT_FILE is set, they also receive
  // $STAGE_REVIEW_FAILED_CRITERIA_FILE. In that case, review only the listed failed
  // criteria plus previously passing criteria affected by the changed paths, and
  // write only criteria judged in this round; the driver merges the prior verdict.
  // Without those prior-review inputs, review every success criterion.
  // Each command must write
  // exactly {"criteria":[{"criterion":"...","verdict":"PASS|FAIL","reason":"..."}],
  // "approved":true|false}, with no other keys at either level. criteria must be
  // non-empty with unique, non-empty one-line criterion and reason values. approved
  // is true exactly when every criterion passes. Review prose may still go to
  // $STAGE_WORK_LOG_PATH, but prose never decides the result. A merged verdict retains
  // every criterion and adds reviewed_in_round so carried results are explicit.
  "review": {
    "reviewers": {
      "claude": "",
      "codex": ""
    },
    "strengths": {
      "off": null,
      "light": "",
      "standard": "",
      "deep": "",
      "red-team": ""
    },
    "stages": {
      "design": "off",
      "implementation": "off",
      "promotion": "off"
    }
  }
}
