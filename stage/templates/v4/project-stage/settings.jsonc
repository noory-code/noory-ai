{
  // Selects the Stage responsibility topology and migration contract.
  "schema_version": 5,
  // Selects the language for human-readable project Stage documents.
  "language": "en",
  // Lists template-backed guidance files intentionally owned by this project.
  "guidance_overrides": [],
  // Lists project-owned operation documents that replace plugin defaults.
  "operations_overrides": [],
  // Maps each work kind to its required execution venue.
  "venue_routing": {},
  // Maps an execution environment to the venue that runs there, e.g. {"cloud": "claude"} when a
  // cloud session has no Codex. A card with environment: cloud, that venue, and review: pending
  // may contradict venue_routing without a venue exception decision (operations/cloud-execution.md).
  "environment_venues": {},
  // Excludes project paths or extensions from Stage write governance.
  "governance": {
    "exclude_paths": [],
    "exclude_extensions": []
  },
  // Registers additional host tool names that can write files.
  "extra_write_tools": [],
  // Executor commands are project-specific. Put each tool's explicit model option, such as
  // --model <model>, directly in all executor and review command strings; do not rely on a
  // user-home default. Give both venue prompts these instructions:
  // Read the selected card at $STAGE_WORK_ITEM_PATH and every ancestor card listed in $STAGE_WORK_ITEM_ANCESTOR_PATHS before acting; together they are the whole instruction.
  // Do work needed for the card's purpose, including work outside its declared scope.
  // Report every decision you make and every scope boundary crossing.
  // Skip work the purpose does not need without reporting it.
  // When you judge the work item itself wrong, change nothing at all and report why, so a person can withdraw or redesign it.
  // Before exiting, set the selected card's frontmatter 'promotion' to the actual final choice.
  // Do not edit the card's status, verification, review, retrospective, or retrospective_ref
  // fields; close_work.py and the retrospective procedure own them, and the driver rejects and
  // restores an attempt that changes them.
  // Use 'not_applicable' only when the card owns no decision or only one-time venue exceptions;
  // any other linked decision requires an explicit 'approved', 'deferred', or 'rejected' choice.
  // After every declared promotion path has been written, use 'promoted' so the audit can distinguish choosing promotion from completing it.
  // Add non-empty single-line Decisions made: and Work not done: fields to the executor report.
  // Use None when there is nothing to report for a field.
  // Decisions made: in every attempt restates each earlier decision still in effect,
  // because close copies only the latest report onto the card.
  // Read failed criteria from the JSON object at $STAGE_REVIEW_VERDICT_FILE and use
  // each exact criterion string in Review dispositions (JSON).
  // When you accept a failed criterion that quotes example inputs, name the kind of input the
  // examples belong to, fix every input of that kind, and test each variant; do not fix only the
  // quoted examples (Dasina R-00000028, R-00000031).
  // Changed paths (JSON) must contain every repository-relative path changed for this card across all attempts.
  "executors": {
    "claude": "",
    "codex": ""
  },
  // Optional venue checks run before an executor attempt. A missing venue warns; null explicitly
  // declares that the venue needs no check. Replace null with a non-empty command to enable one.
  "preflights": {
    "claude": null,
    "codex": null
  },
  // These are per-action baselines. The driver keeps attempts fixed per action and
  // scales command timeout, iteration, and wall-clock ceilings to the target subtree's leaf count.
  "limits": {
    "max_attempts_per_item": 3,
    "max_iterations": 12,
    "max_wall_clock_seconds": 5400
  },
  // Review commands receive $STAGE_REVIEW_MODE ('full' or 'narrow'),
  // $STAGE_REVIEW_VERDICT_FILE, and $STAGE_CHANGED_PATHS_FILE.
  // When $STAGE_PREVIOUS_REVIEW_VERDICT_FILE is set, they also receive
  // $STAGE_REVIEW_FAILED_CRITERIA_FILE. In that case, review only the listed failed
  // criteria plus previously passing criteria affected by the changed paths, and
  // write only criteria judged in this round; the driver merges the prior verdict.
  // Without those prior-review inputs, review every success criterion.
  // A non-interactive claude -p reviewer needs explicit permissions: put --add-dir with the folder of
  // $STAGE_CHANGED_PATHS_FILE and --allowedTools with an Edit rule for the absolute path
  // /$STAGE_REVIEW_VERDICT_FILE (Edit rules govern every file write) plus
  // Bash(python3 -m unittest:*), then -- before the prompt.
  // Do not grant edits to project files. Those rules cover only the reviewer's own tool
  // calls, not code its tests run, so close_work.py and the driver compare the repository
  // around every review command and fail a review that changed any file but its verdict.
  // Read the non-empty Decisions made: and Work not done: fields in the latest executor report and judge whether the purpose and scope-boundary reporting contract was followed.
  // When a criterion fails on example inputs, name in its reason the kind of input those
  // examples belong to, so the next executor round can fix the whole kind.
  // Each command must write
  // exactly {"criteria":[{"criterion":"...","verdict":"PASS|FAIL","reason":"..."}],
  // "approved":true|false}, with no other keys at either level. criteria must be
  // non-empty with unique, non-empty one-line criterion and reason values. approved
  // is true exactly when every criterion passes. Review prose may still go to
  // $STAGE_WORK_LOG_PATH, but prose never decides the result. A merged verdict retains
  // every criterion and adds reviewed_in_round so carried results are explicit.
  "review": {
    "reviewers": {
      "claude": "",
      "codex": ""
    },
    "strengths": {
      "off": null,
      "light": "",
      "standard": "",
      "deep": "",
      "red-team": ""
    },
    "stages": {
      "design": "off",
      "implementation": "off",
      "promotion": "off"
    }
  }
}
