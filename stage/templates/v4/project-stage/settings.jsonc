{
  // Selects the Stage responsibility topology and migration contract.
  "schema_version": 5,
  // Selects the language for human-readable project Stage documents.
  "language": "en",
  // Lists template-backed guidance files intentionally owned by this project.
  "guidance_overrides": [],
  // Lists project-owned operation documents that replace plugin defaults.
  "operations_overrides": [],
  // Maps each work kind to its required execution venue.
  "venue_routing": {},
  // Maps an execution environment to the venue that runs there, e.g. {"cloud": "claude"} when a
  // cloud session has no Codex. A card with environment: cloud, that venue, and review: pending
  // may contradict venue_routing without a venue exception decision (operations/cloud-execution.md).
  "environment_venues": {},
  // Excludes project paths or extensions from Stage write governance.
  "governance": {
    "exclude_paths": [],
    "exclude_extensions": []
  },
  // Registers additional host tool names that can write files.
  "extra_write_tools": [],
  // Names model and effort tiers, cheapest first: declaration order is cost order. Each tier gives
  // every venue its own model and effort, written exactly as that venue's tools accept them; Stage
  // never translates between venues. A card records one tier in its frontmatter tier field. Write
  // claude models as the Agent tool's aliases (haiku, sonnet, opus, fable). Add a codex or other
  // venue column with the model names your account accepts. Delete model_tiers and tier_routing
  // to turn tiers off.
  "model_tiers": {
    "scout": {"claude": {"model": "haiku", "effort": "low"}},
    "standard": {"claude": {"model": "sonnet", "effort": "medium"}},
    "strong": {"claude": {"model": "opus", "effort": "high"}},
    "lead": {"claude": {"model": "fable", "effort": "high"}}
  },
  // Picks a new card's tier from its kind and scale. A kind maps to a tier, or to
  // {"epic"|"story"|"action": tier} with "*" as that kind's fallback; the top-level "*" covers
  // every other kind. "lead" is for planning, instructions, and checking results, so no kind
  // routes to it by default. A person may change a card's tier; the card's value wins.
  "tier_routing": {"*": "standard"},
  // Lists, per venue, the models the driver moves through when a usage limit stops one, in
  // preference order. Each inner list is a group of models that share one usage limit, so a limit on
  // one skips its whole group. The driver first runs the card tier's model, then on a usage limit
  // reruns the same turn with $STAGE_MODEL set to the next unspent group's first model; those
  // reruns are not attempts. Example: {"agy": [["claude-sonnet-5-5-high", "gpt-oss"],
  // ["gemini-4-argon-medium"], ["gemini-3.8-flash"]]}. Commands must read "$STAGE_MODEL".
  "model_fallbacks": {},
  // Regular expressions, per venue, that mark a failed command's output as a usage limit, for
  // example {"agy": ["RESOURCE_EXHAUSTED", "code 429"]}. Without a venue's patterns its usage limits
  // are ordinary failures. When every group is spent the driver stops and says so.
  "usage_limit_patterns": {},
  // Executor commands are project-specific. Put each tool's explicit model option, such as
  // --model <model>, in all executor and review command strings; do not rely on a user-home
  // default. With model_tiers, write --model "$STAGE_MODEL" and the effort flag with
  // "$STAGE_EFFORT" so the card's tier picks them: the driver exports the executor's venue values
  // to executors and the reviewer's venue values to reviewers. Give both venue prompts these
  // instructions:
  // Read the selected card at $STAGE_WORK_ITEM_PATH and every ancestor card listed in $STAGE_WORK_ITEM_ANCESTOR_PATHS before acting; together they are the whole instruction.
  // Do work needed for the card's purpose, including work outside its declared scope.
  // Report every decision you make and every scope boundary crossing.
  // Skip work the purpose does not need without reporting it.
  // When you judge the work item itself wrong, change nothing at all and report why, so a person can withdraw or redesign it.
  // Before exiting, set the selected card's frontmatter 'promotion' to the actual final choice.
  // Do not edit the card's status, verification, review, retrospective, or retrospective_ref
  // fields; close_work.py and the retrospective procedure own them, and the driver rejects and
  // restores an attempt that changes them.
  // Use 'not_applicable' only when the card owns no decision or only one-time venue exceptions;
  // any other linked decision requires an explicit 'approved', 'deferred', or 'rejected' choice.
  // After every declared promotion path has been written, use 'promoted' so the audit can distinguish choosing promotion from completing it.
  // Add non-empty single-line Decisions made: and Work not done: fields to the executor report.
  // Use None when there is nothing to report for a field.
  // Decisions made: in every attempt restates each earlier decision still in effect,
  // because close copies only the latest report onto the card.
  // Read failed criteria from the JSON object at $STAGE_REVIEW_VERDICT_FILE and use
  // each exact criterion string in Review dispositions (JSON).
  // When you accept a failed criterion that quotes example inputs, name the kind of input the
  // examples belong to, fix every input of that kind, and test each variant; do not fix only the
  // quoted examples (Dasina R-00000028, R-00000031).
  // Changed paths (JSON) must contain every repository-relative path changed for this card across all attempts.
  "executors": {
    "claude": "",
    "codex": ""
  },
  // Optional venue checks run before an executor attempt. A missing venue warns; null explicitly
  // declares that the venue needs no check. Replace null with a non-empty command to enable one.
  "preflights": {
    "claude": null,
    "codex": null
  },
  // These are per-action baselines. The driver keeps attempts fixed per action and
  // scales command timeout, iteration, and wall-clock ceilings to the target subtree's leaf count.
  "limits": {
    "max_attempts_per_item": 3,
    "max_iterations": 12,
    "max_wall_clock_seconds": 5400
  },
  // Review commands receive $STAGE_REVIEW_MODE ('full' or 'narrow'),
  // $STAGE_REVIEW_VERDICT_FILE, and $STAGE_CHANGED_PATHS_FILE.
  // When $STAGE_PREVIOUS_REVIEW_VERDICT_FILE is set, they also receive
  // $STAGE_REVIEW_FAILED_CRITERIA_FILE. In that case, review only the listed failed
  // criteria plus previously passing criteria affected by the changed paths, and
  // write only criteria judged in this round; the driver merges the prior verdict.
  // Without those prior-review inputs, review every success criterion.
  // A non-interactive claude -p reviewer needs explicit permissions: put --add-dir with the folder of
  // $STAGE_CHANGED_PATHS_FILE and --allowedTools with an Edit rule for the absolute path
  // /$STAGE_REVIEW_VERDICT_FILE (Edit rules govern every file write) plus Bash, so the
  // reviewer can run the card's checks and commands it chooses itself; add
  // --disallowedTools with Bash(git push), Bash(git push:*), Bash(git commit), and
  // Bash(git commit:*); then -- before the prompt. stage/scripts/claude_review_companion.py
  // builds exactly this command.
  // Do not grant edits to project files. Those rules cover only the reviewer's own tool
  // calls, not code its tests run, so close_work.py and the driver compare the repository
  // around every review command and fail a review that changed any file but its verdict.
  // That comparison does not see a change outside the repository.
  // Read the non-empty Decisions made: and Work not done: fields in the latest executor report and judge whether the purpose and scope-boundary reporting contract was followed.
  // When a criterion fails on example inputs, name in its reason the kind of input those
  // examples belong to, so the next executor round can fix the whole kind.
  // method says how you judged that criterion: ran when you ran a command or observed the
  // behavior yourself, read when you read files or records, unable when you could not gather
  // the evidence the criterion needs.
  // A criterion whose evidence you did not see yourself is FAIL: the executor report, the
  // work log, and comments in the code are claims, not evidence.
  // A criterion that asks for a command result or observed behavior needs method ran, and a
  // criterion with method unable is always FAIL.
  // The exception is a criterion that only a whole session, a machine of the user, or the user
  // can show: judge it with method read from a line under ## Verification of the card that
  // starts with - Observed, - Checked, or - User verdict and names that criterion. Pass it
  // only when that line says held and gives its date, where it was checked, the command or
  // action, and what it showed; a - User verdict line gives its date, the words of the user, and
  // what the verdict rests on. Say in its reason which line you read and that you did not
  // run the check yourself. When the card has no such line for the criterion, its method is
  // unable.
  // close_work.py appends what the card's checks printed to $STAGE_WORK_LOG_PATH as a
  // "### Checks at close" section before the review starts; read it there.
  // close_work.py runs the stored acceptance checks of the card itself, so repeating one is
  // not your evidence: for each criterion that needs method ran, run at least one command you
  // chose yourself that could show the criterion false, and say in its reason which command
  // you ran and what it showed.
  // Change no file other than $STAGE_REVIEW_VERDICT_FILE, keep scratch files in the system
  // temp folder, and never commit or push: a review that changes the repository fails.
  // Each command must write
  // exactly {"criteria":[{"criterion":"...","verdict":"PASS|FAIL",
  // "method":"ran|read|unable","reason":"..."}],
  // "approved":true|false}, with no other keys at either level. criteria must be
  // non-empty with unique, non-empty one-line criterion and reason values. A verdict that
  // marks a criterion PASS with method unable is invalid, and the method of every criterion
  // is written on the card beside its verdict. approved
  // is true exactly when every criterion passes. Review prose may still go to
  // $STAGE_WORK_LOG_PATH, but prose never decides the result. To record that prose on
  // every platform, start the command with: python3 stage/scripts/run_review.py --label <name>
  // -- <reviewer command>. Shell syntax that captures and appends output runs in a POSIX
  // shell or in cmd.exe, never both (docs/SCHEMA_V4.md). A merged verdict retains
  // every criterion and adds reviewed_in_round so carried results are explicit.
  "review": {
    "reviewers": {
      "claude": "",
      "codex": ""
    },
    "strengths": {
      "off": null,
      "light": "",
      "standard": "",
      "deep": "",
      "red-team": ""
    },
    "stages": {
      "design": "off",
      "implementation": "off",
      "promotion": "off"
    }
  }
}
