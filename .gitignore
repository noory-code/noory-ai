# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/

# Test / coverage
.coverage
coverage.xml
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# OS
.DS_Store

# IDE
.idea/
.vscode/
.obsidian/
*.swp

# MCP / Claude local (local overrides — not committed; plugin .mcp.json is committed)
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Secrets
.env
.envrc
*.key
*.pem
credentials*
secrets*

# Package runtime data (should not be committed from dev machines)
.evonest/
.distill/

# Session handoff (local only)
HANDOFF.md

# Playwright MCP scratch (session traces, screenshots saved to root)
.playwright-mcp/

# Solera VSCode extension build artifacts (solera/vscode-extension/)
solera/vscode-extension/node_modules/
solera/vscode-extension/out/
# Viewer dist is regenerated by `npm run vscode:prepublish` from ../viewer/dist/
solera/vscode-extension/media/viewer/
# Packaged extension
solera/vscode-extension/*.vsix
# Integration test scaffolding (test-electron downloads VSCode here, ~120MB)
solera/vscode-extension/.vscode-test/

# Solera viewer dev deps + build output (solera/viewer/)
solera/viewer/node_modules/
# viewer/dist/ IS committed (ships with the plugin); don't ignore it

# Catch-all for any stray ``node_modules/`` at any depth — primarily
# the Vite / Vitest cache directories that get accidentally created
# at the repo root when a tool runs from the wrong cwd. Each viewer
# subpackage already lists its own ``node_modules/`` rule above
# (solera/) or in its own ``.gitignore`` (plot/, plot/viewer/); this
# catch-all is just the safety net.
node_modules/
