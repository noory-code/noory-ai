# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/

# Test / coverage
.coverage
coverage.xml
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# OS
.DS_Store

# IDE
.idea/
.vscode/
.obsidian/
*.swp

# MCP / Claude local (local overrides — not committed; plugin .mcp.json is committed)
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Secrets
.env
.envrc
*.key
*.pem
credentials*
secrets*

# Package runtime data (should not be committed from dev machines)
.evonest/
.distill/

# Session handoff (local only)
HANDOFF.md

# Playwright MCP scratch (session traces, screenshots saved to root)
.playwright-mcp/

# VSCode extension build artifacts (solera-map-vscode/)
solera-map-vscode/node_modules/
solera-map-vscode/out/
# Viewer dist is regenerated by `npm run vscode:prepublish` from solera-map/viewer/dist/
solera-map-vscode/media/viewer/
# Packaged extension
solera-map-vscode/*.vsix
