# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/

# Test / coverage
.coverage
coverage.xml
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# OS
.DS_Store

# IDE
.idea/
.vscode/
.obsidian/
*.swp

# MCP / Claude local (local overrides — not committed; plugin .mcp.json is committed)
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Secrets
.env
.envrc
*.key
*.pem
credentials*
secrets*

# Package runtime data (should not be committed from dev machines)
.evonest/
.distill/

# Session handoff (local only)
HANDOFF.md

# Stage local discussion notes (review scratch — not committed)
stage/.discuss/

# Playwright MCP scratch (session traces, screenshots saved to root)
.playwright-mcp/

# Catch-all for any stray ``node_modules/`` at any depth — primarily
# the Vite / Vitest cache directories that get accidentally created
# at the repo root when a tool runs from the wrong cwd.
node_modules/

# Novel runtime data (engine mkdirs .noory/ in browsed dirs — see B-4 side-effect note)
.noory/

.stage/.runtime/