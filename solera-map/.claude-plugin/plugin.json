{
  "name": "solera-map",
  "version": "0.1.0",
  "description": "Mindmap-style visual layer over Solera — Service / Plan / Build / Live canvases for drawing and tracking a product with AI. Service is upstream of Plan: Personas / Journeys / Narratives propose Concepts that flow into Plan.",
  "homepage": "https://github.com/noory-code/noory-ai/tree/main/solera-map",
  "repository": "https://github.com/noory-code/noory-ai",
  "license": "MIT",
  "keywords": ["mcp", "solera", "mindmap", "product-map", "claude-code", "persona", "journey", "narrative", "service-design"],
  "author": {
    "name": "noory-code",
    "url": "https://github.com/noory-code"
  },
  "commands": "./commands/",
  "mcpServers": {
    "solera-map": {
      "command": "uv",
      "args": ["run", "--directory", "${CLAUDE_PLUGIN_ROOT}", "python", "-m", "solera_map"]
    }
  }
}
